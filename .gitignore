.DS_Store

# ---------------------------------------------------------------------------
# Credentials — never commit.
# 'token/' holds the Pure1 API key pair, the token-refresh scripts, and their
# log. The scripts are deliberately kept untracked too: refresh_pure1_token.sh
# hardcodes a Pure1 API key ID. Parameterise that before tracking them.
# ---------------------------------------------------------------------------
token
token/
token/*
*.token
*.pem
auth-config.json

# Editor swap files
.*.sw[a-p]

